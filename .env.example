# CommandClaw (Rust rebuild) — environment
# Copy to .env and fill in. `.env` is gitignored; never commit real secrets.
# Vars are grouped by M1 build step (see plan/M1-delegation-slice.md).

# --- S1: Telegram channel ---
# teloxide reads TELOXIDE_TOKEN by convention. Create a bot via @BotFather and paste its token.
TELOXIDE_TOKEN=123456:ABC-DEF...

# Restrict the bot to your own chat(s). Get your id from @userinfobot.
# Empty = allow all (ok for local dev; tighten before the bot can trigger code changes).
COMMANDCLAW_ALLOWED_CHAT_IDS=

# --- S2: Model layer ---
# async-openai reads OPENAI_API_KEY (and OPENAI_BASE_URL for OpenAI-compatible endpoints).
# Dev on whatever's simplest; the AFK-friendly-provider choice is post-M1 (see ADR-0001 addendum).
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
COMMANDCLAW_MODEL=gpt-4o-mini

# --- S4 / S6: The seam (CKRV's MCP server) ---
# ckrv-mcp runs as a localhost server (WSL or Windows; localhost forwards either way).
# CKRV_MCP_URL=http://127.0.0.1:8420
